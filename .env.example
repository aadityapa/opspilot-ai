# OpsPilot settings. Copy to .env (git-ignored) or let `npm run setup` write it.
#
# How each setting is classified — the server validates all of them at startup with one parser
# (server/config-schema.ts) and refuses to start on an invalid or missing value, naming the setting
# and never printing its value:
#
#   REQUIRED         DATABASE_URL, APP_ORIGIN
#   PRODUCTION ONLY  APP_SECRET (required there; a fixed development value is used elsewhere and
#                    logged as such), NODE_ENV=production, HTTPS APP_ORIGIN, MAIL_MODE=disabled,
#                    ALLOW_DEMO_SEED=false — all enforced, not advisory
#   DEVELOPMENT ONLY DEMO_PASSWORD, ALLOW_DEMO_SEED=true, TEST_DATABASE_URL, E2E_DATABASE_URL,
#                    MAIL_MODE=mailpit, MAILPIT_*, AI_MODE=mock for demos
#   OPTIONAL         everything else, with the defaults shown
#
# Never commit a real password, key or token. `npm run doctor:prod` validates .env.production the
# same way before a deployment.

NODE_ENV=development
DATABASE_URL=postgresql://opspilot:local-only-db-password@localhost:5433/opspilot
APP_ORIGIN=http://localhost:5173
PORT=3001
ALLOW_DEMO_SEED=false
# DEVELOPMENT ONLY. Password for the four fictional demo accounts; the seed refuses to run without
# it, in production, or against a database on another host. At least 16 characters.
DEMO_PASSWORD=
TEST_DATABASE_URL=postgresql://opspilot:local-only-db-password@localhost:5433/opspilot_test
E2E_DATABASE_URL=postgresql://opspilot:local-only-db-password@localhost:5433/opspilot_e2e_test

# Notification delivery.
#   disabled = queue notifications in the outbox but never hand them to a mail transport (default).
#   mailpit  = deliver to the local Mailpit sink started by compose.yaml; read them at http://localhost:8025.
# No other transport exists. There is no SMTP URL, relay host or credential setting, so the
# application cannot be pointed at a real mail server by configuration. Production refuses
# anything other than "disabled" at startup.
MAIL_MODE=mailpit
# Only 127.0.0.1, localhost or the compose service name "mailpit" are accepted. Port is fixed at 1025.
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# Login attempts allowed per IP per 15 minutes. Raise only where many people legitimately share one
# address (an office behind NAT) or for an automated browser suite. It is per-IP, not per-account.
LOGIN_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Account security (Phase 5)
# ---------------------------------------------------------------------------
# Encrypts authenticator secrets at rest. `npm run setup` generates one; production refuses to
# start without it. At least 32 characters. Changing it makes every enrolled authenticator
# unreadable — people would need to enrol again.
APP_SECRET=
# Consecutive failed sign-ins (or second-factor codes) before an account is locked, and for how long.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Roles that must have an authenticator enrolled before they can use the application.
# Comma-separated: EMPLOYEE, ENGINEER, ADMIN. Empty means two-factor is optional for everyone.
MFA_REQUIRED_ROLES=
# Session lifetime in hours. Sessions are server-side and can be revoked at any time.
SESSION_HOURS=8

# ---------------------------------------------------------------------------
# Operations (Phase 5)
# ---------------------------------------------------------------------------
# Request logs: one JSON line per API request (method, route, status, duration, request id, user id —
# never bodies, query strings or cookies). "off" silences them.
LOG_FORMAT=json
# Bearer token for GET /metrics (Prometheus text format). Empty disables the endpoint.
METRICS_TOKEN=
# Retention in days; 0 keeps forever. Audit events attached to a ticket are never pruned.
RETENTION_AUDIT_DAYS=365
RETENTION_AI_USAGE_DAYS=90
RETENTION_OUTBOX_DAYS=30

# ---------------------------------------------------------------------------
# Workspace (Phase 6)
# ---------------------------------------------------------------------------
# Ticket attachments: stored on disk under this folder (git-ignored), never inside the web root,
# always served as downloads. Allowed types: images, PDF, text/CSV/log, docx, xlsx, zip.
UPLOAD_DIR=uploads
ATTACHMENT_MAX_MB=10

# ---------------------------------------------------------------------------
# AI (Phase 3)
# ---------------------------------------------------------------------------
#   disabled = every AI feature is off. Tickets, SLA, assets, knowledge and notifications all work
#              exactly as before; AI endpoints answer 503 and the interface says so.
#   mock     = deterministic offline stand-in. No credentials, no network calls, same output every
#              time, and clearly labelled "Mock AI" everywhere it appears. Good for demos and tests.
#   openai   = the official OpenAI API. Requires OPENAI_API_KEY.
# There is deliberately no base-URL setting, so the provider cannot be pointed at another host by
# configuration. The key is read on the server only and is never sent to the browser or logged.
AI_MODE=mock

# Required only when AI_MODE=openai. Startup fails if it is set in any other mode, so a key cannot
# be left behind by accident. Never commit a real value.
OPENAI_API_KEY=

# Chat model. Any model name your account can use; validated as a plain identifier.
AI_CHAT_MODEL=gpt-4o-mini
# Embedding model and vector size. text-embedding-3-small is native 1536, -3-large is native 3072;
# a smaller value is allowed, a larger one is refused at startup. Changing either value makes every
# stored passage stale — reindex from Settings → AI & retrieval, or run `npm run ai:reindex`.
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Safety rails. Timeout per provider call, hard caps on input and output size, how many AI calls may
# run at once, and how many requests one user may make per rolling 24 hours.
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_INPUT_CHARS=12000
AI_MAX_CONCURRENCY=2
AI_DAILY_USER_LIMIT=50

# Retrieval. How many passages to consider, and the absolute cosine floor below which nothing counts
# as evidence. Mock and real embeddings occupy differently-scaled spaces, so this is tunable; a
# relative floor is also applied so weakly-related passages are not passed off as sources.
AI_RETRIEVAL_TOP_K=5
AI_MIN_SIMILARITY=0.1

# Evidence bars, applied by the server regardless of what the model claims. AI_MIN_SIMILARITY above
# decides what is a retrieval *candidate*; these decide what counts as *support*, and can only ever
# withhold an answer. Chosen from the development evaluation set and validated on held-out cases.
# Re-check them if you switch to a real embedding model — see docs/EVALUATION.md.
#   ANSWER_SIMILARITY      the best passage must be at least this close to the question
#   QUESTION_TERM_OVERLAP  this share of the question's content words must appear in the passages
#   CITATION_SUPPORT       a cited passage must share this much substance with the written answer
AI_MIN_ANSWER_SIMILARITY=0.2
AI_MIN_QUESTION_TERM_OVERLAP=0.25
AI_MIN_CITATION_SUPPORT=0.12
