# Production settings for compose.prod.yaml. Copy to .env.production (git-ignored) and fill in.
# Validate before deploying:  npm run doctor:prod
#
# Everything marked REQUIRED has no default; the deployment refuses to start without it.

# REQUIRED. The public host name. APP_ORIGIN becomes https://<DOMAIN>; Caddy obtains its certificate.
DOMAIN=
# REQUIRED. Contact address for the certificate authority.
ACME_EMAIL=

# REQUIRED. Database password. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# REQUIRED. Encrypts second-factor secrets at rest. At least 32 characters. Same generator, 48 bytes.
APP_SECRET=

# Bearer token for /metrics on the backend network. Empty disables the endpoint.
METRICS_TOKEN=

# Roles that must enrol a second factor before they can work. Administrators by default.
MFA_REQUIRED_ROLES=ADMIN

# AI. "disabled" is the safe default; "openai" needs a key and sends ticket text to OpenAI.
AI_MODE=disabled
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Sign-in protection.
LOGIN_RATE_LIMIT=20
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
SESSION_HOURS=8

# Retention, in days. 0 keeps forever. Ticket-bound audit events are never pruned.
RETENTION_AUDIT_DAYS=365
RETENTION_AI_USAGE_DAYS=90
RETENTION_OUTBOX_DAYS=30

# Ticket attachments: per-file limit in MB. Files live on the uploads volume.
ATTACHMENT_MAX_MB=10

# Image tag to build and run.
IMAGE_TAG=latest
